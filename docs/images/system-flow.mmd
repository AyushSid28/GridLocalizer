flowchart TB
 subgraph GRID["Electrical grid"]
        FAULT["Fault: span, DT, or feeder"]
        DARK["Downstream poles lose power"]
        IOT["Pole devices: heartbeat / power_lost / silence"]
  end
 subgraph INGEST["Ingest & state"]
        API["POST /telemetry"]
        SIM["Simulator: inject · repair · noise · scenario"]
        SYNC["Sim: update pole_states in Postgres"]
        REDIS[("Redis Stream")]
        WORKER["Worker: dedup by device_id + seq"]
        STATE[("pole_states")]
        DEBOUNCE["dt_dirty debounce DETECT_WAIT_SEC"]
        LOC["run_global_localization"]
  end
 subgraph LOCALIZE["Localize & trust"]
        FILTER{"Trust filters"}
        NOISE["Sensor issue — no outage ticket"]
        SUPPRESS["Suppress or note"]
        CLASSIFY{"Pattern?"}
        KIND_F["feeder ticket"]
        KIND_D["DT ticket"]
        KIND_S["span ticket at frontier edge"]
        ONE["One incident per fault"]
        DETECTED["status: detected"]
  end
 subgraph CONSOLE["Operator console"]
        UI["Incident Center + map + PIN + confidence"]
        ACK["acknowledge"]
        CREW["assign crew"]
        ASSIGNED["status: crew_assigned"]
        REPAIR["Simulation repair — same scope as fault"]
        REST["boot + power_restored telemetry"]
        READY{"Restoration telemetry ready?"}
        BLOCK["Confirm repair disabled / HTTP 409"]
        RESOLVE["confirm repair — POST resolve"]
        VERIFY["Verifier: boot + power_restored after outage"]
        CLOSED["status: closed"]
  end
    FAULT --> DARK
    DARK --> IOT
    IOT --> API
    SIM --> API & SYNC
    API --> REDIS
    REDIS --> WORKER
    WORKER --> STATE & DEBOUNCE
    SYNC --> LOC
    DEBOUNCE --> LOC
    LOC --> FILTER
    FILTER -- Dark pole, live children --> NOISE
    FILTER -- Scheduled outage soft-match --> SUPPRESS
    FILTER -- Real outage --> CLASSIFY
    CLASSIFY -- All feeder dark --> KIND_F
    CLASSIFY -- Whole DT dark --> KIND_D
    CLASSIFY -- Live to dark on tree --> KIND_S
    KIND_F --> ONE
    KIND_D --> ONE
    KIND_S --> ONE
    ONE --> DETECTED
    DETECTED --> UI
    UI --> ACK
    ACK --> CREW
    CREW --> ASSIGNED
    ASSIGNED --> REPAIR
    REPAIR --> REST
    REST --> READY
    READY -- No --> BLOCK
    READY -- Yes --> RESOLVE
    RESOLVE --> VERIFY
    VERIFY --> CLOSED
    GRID --> INGEST
    INGEST --> LOCALIZE
    LOCALIZE --> CONSOLE
