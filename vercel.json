{
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://gridlocalizer-backend.onrender.com/health"
    },
    {
      "source": "/health/:path*",
      "destination": "https://gridlocalizer-backend.onrender.com/health/:path*"
    },
    {
      "source": "/network/:path*",
      "destination": "https://gridlocalizer-backend.onrender.com/network/:path*"
    },
    {
      "source": "/incidents/:path*",
      "destination": "https://gridlocalizer-backend.onrender.com/incidents/:path*"
    },
    {
      "source": "/sim/:path*",
      "destination": "https://gridlocalizer-backend.onrender.com/sim/:path*"
    },
    {
      "source": "/telemetry",
      "destination": "https://gridlocalizer-backend.onrender.com/telemetry"
    },
    {
      "source": "/breadcrumb/:path*",
      "destination": "https://gridlocalizer-backend.onrender.com/breadcrumb/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://gridlocalizer-backend.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://gridlocalizer-backend.onrender.com/openapi.json"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
